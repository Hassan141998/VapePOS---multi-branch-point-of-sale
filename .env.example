# Copy this file to ".env" (same folder as docker-compose.yml) and fill in the blanks.

# Database password. Use letters and digits only (it goes inside a URL), e.g. run:  openssl rand -hex 16
POSTGRES_PASSWORD=

# Secret used to sign login tokens. Generate one with:  openssl rand -hex 32
SECRET_KEY=

# Which timezone decides "today" for reports and end-of-day (IANA name)
# Examples: America/New_York, America/Chicago, Europe/London, Asia/Dubai
BUSINESS_TIMEZONE=America/New_York

# Port where the app is served on this machine (http://localhost:8080)
WEB_PORT=8080

# Optional
# POSTGRES_USER=vapepos
# POSTGRES_DB=vapepos
# ACCESS_TOKEN_EXPIRE_MINUTES=720
