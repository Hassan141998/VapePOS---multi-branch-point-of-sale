# Only needed when the API is NOT on the same address as the website
# (for example the website is on Vercel and the API is somewhere else).
# Set these in Vercel -> Project -> Settings -> Environment Variables, then redeploy.

# Full URL of the API, no trailing slash
# VITE_API_URL=https://vapepos-api.vercel.app

# Set to "poll" if the API host cannot do WebSockets (e.g. the API is on Vercel)
# VITE_REALTIME=poll

# Currency shown in the app (ISO code)
# VITE_CURRENCY=USD
