# Copy to backend/.env for local development:   Copy-Item .env.example .env   (PowerShell)   |   cp .env.example .env   (Mac/Linux)
ENVIRONMENT=development

# PostgreSQL. Paste a Neon string as-is (use Neon's DIRECT string here, not the "-pooler" one), or a local server:
#   postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#   postgresql://vapepos:vapepos@localhost:5432/vapepos
DATABASE_URL=postgresql://vapepos:vapepos@localhost:5432/vapepos

# Long random text that signs logins. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=720

# Website address(es) allowed to call the API, comma separated, no trailing slash
CORS_ORIGINS=http://localhost:5173

# IANA timezone that decides what "today" means for reports and end-of-day,
# e.g. Asia/Karachi, Asia/Dubai, Europe/London, America/New_York
BUSINESS_TIMEZONE=UTC
